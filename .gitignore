# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/
ENV/

# Test / type-check caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/

# Jupyter
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Plot / analysis scripts (not part of public release; reproduce figures from
# the published experiment CSVs using your own scripts).
# NOTE: plot_ground_truth.py and plot_experiment.py are deliberately NOT
# ignored — they are pipeline glue invoked by the orchestrators and runners.
plot_code/
plots_for_results/
**/plots_for_results/
**/plot.py
**/plot[0-9]*.py

# Bench-top / static-target calibration scripts (not part of the rotor sweep)
**/static_main.py
**/static_test.py

# Generated figure outputs
*.png
*.pdf
*.svg
*.eps
*.jpg
*.jpeg

# ...except the curated README/doc figures in images/
!images/
!images/*.png

# YOLOR_Training assets that ship with the release
!YOLOR_Training/model_cards/**/*.png
!YOLOR_Training/model_cards/**/*.jpg
!YOLOR_Training/*.png
!YOLOR_Training/*.jpg
!images/*.pdf
!images/*.jpg
!images/*.jpeg

# ...and the PNG result plots under final_results/ (SVG / EPS / PDF stay ignored)
!final_results/**/*.png

# Per-run terminal / debug / device logs (any file with "log" in its name).
# Covers automatic_evaluation_terminal_log.txt, offline_*_log.txt, debug_log.txt,
# experiment_log.txt, logfile_tx.txt, logfile_rx.txt, etc. requirements.txt is
# unaffected because it has no "log" in the basename.
*.log
**/*log*.txt
**/logfile*.txt

# Per-experiment output trees written by the runners
**/Adaptive_Beamforming_SC/
**/Outdoor_Adaptive_Beamforming_SC/

# Discrete-rotor experiment tree (kept locally, not part of public release)
indoor/discrete/

# Local session notes (not part of public release)
SESSION_CHANGES.txt

# One-off analysis / calibration utilities (kept locally, not shipped)
outdoor/extract_beam_indices_gt.py
outdoor/Calibrated_PRx.py

# --- YOLOR_Training (Stage-1 YOLOv11 detector) artifacts ----------------
# Source datasets are NOT redistributed; users obtain them from the authors
# (see YOLOR_Training/README.md §Datasets).
# YOLOR_Training/Datasets — keep the expected folder structure visible
# on GitHub (.gitkeep markers + a README), but ignore the actual data.
YOLOR_Training/Datasets/*/FullDataset/Images/*
YOLOR_Training/Datasets/*/FullDataset/Labels/*
YOLOR_Training/Datasets/*/splits/*
!YOLOR_Training/Datasets/*/FullDataset/Images/.gitkeep
!YOLOR_Training/Datasets/*/FullDataset/Labels/.gitkeep
!YOLOR_Training/Datasets/*/splits/.gitkeep
YOLOR_Training/FilteredTrainingDatasets/

# Pipeline outputs auto-generated when users run the training/eval scripts.
YOLOR_Training/runs/
YOLOR_Training/runs_old/
YOLOR_Training/logs/
YOLOR_Training/outputs/
YOLOR_Training/coco/
YOLOR_Training/labels_p1/
YOLOR_Training/labels_p1_m5/
YOLOR_Training/dedup/
YOLOR_Training/DESIGN_NOTES.md
YOLOR_Training/RELEASE.md

# Internal artifacts / non-public scratch.
YOLOR_Training/_backups/
YOLOR_Training/yolo11x.pt
YOLOR_Training/*.pt.bak

# SLURM trap sentinels.
YOLOR_Training/.*.keepgoing

# macOS AppleDouble shadows.
._*
